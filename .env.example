# ==============================================================================
# 🤖 AUTONOMOUS JOB HUNTING AGENT CONFIGURATION (.env.example)
# Copy this file to .env and fill in your values:
#   cp .env.example .env   (or 'copy .env.example .env' in Windows PowerShell)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Free Tier: 15 Requests/Min, ~1,500/Day)
# Get your free API key at: https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Ollama Server (Free, Unlimited, Zero Latency)
# Local (installed on your machine): http://localhost:11434
# OR Google Colab ngrok URL (from ollama_server.ipynb): https://xxxx.ngrok-free.app
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_FAST_MODEL=llama3.2:3b

# Optional: OpenRouter API key (fallback or alternative model provider)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# 3. Job Search & Targeting Preferences
# Comma-separated lists of desired roles, locations, and cities
# ------------------------------------------------------------------------------
TARGET_ROLES=Generative AI Engineer,AI Engineer,Machine Learning Engineer,Software Engineer,Full Stack Developer
TARGET_LOCATIONS=Remote,Hybrid,On-site
TARGET_CITIES=Hyderabad,Bangalore,San Francisco,New York
DATE_POSTED_FILTER=past_week
MAX_APPLICATIONS_PER_CYCLE=10

# ------------------------------------------------------------------------------
# 4. Job Eligibility & ATS Match Filters
# ------------------------------------------------------------------------------
INCLUDE_EXTERNAL_APPLY=true
MAX_EXPERIENCE_YEARS=3
MIN_ATS_SCORE_TO_SHOW=25
DAILY_MAX_LINKEDIN=40
DAILY_MAX_INDEED=25
DAILY_MAX_GLASSDOOR=20

# ------------------------------------------------------------------------------
# 5. Anti-Bot Safety Delays (Seconds between actions)
# Randomized delays mimic human behavior to protect accounts from rate limits
# ------------------------------------------------------------------------------
MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=90
BROWSER_PROFILE_DIR=./browser_profile
HEADLESS_MODE=False

# ------------------------------------------------------------------------------
# 6. WhatsApp Desktop Group Notifications (Optional)
# Automates notification delivery to a specified WhatsApp group via desktop app
# ------------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_TARGET_GROUP=Job Alerts
WHATSAPP_MIN_ATS_SCORE=30
